{
  "name": "@sudobility/writing_core",
  "version": "0.1.6",
  "description": "Headless, platform-free writing engine for screenplays, stage plays and manuscripts: collaborative document model (Yjs), templates, editing commands, SmartType and per-session undo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "templates:generate": "bun scripts/generate-builtin-templates.ts",
    "hash:vectors": "bun scripts/generate-hash-vectors.ts",
    "fonts:generate": "bun scripts/build-font-metrics.ts",
    "ucd:generate": "bun scripts/build-ucd.ts",
    "dict:generate": "bun scripts/build-dictionaries.ts",
    "fixtures:build": "bun scripts/build-fixtures.ts",
    "fixtures:reference": "bun scripts/build-reference-docs.ts",
    "golden:update": "bun scripts/golden-update.ts",
    "bench:layout": "vitest run src/layout/layout.bench.test.ts",
    "bench:layout:update": "BENCH_UPDATE_BASELINE=1 vitest run src/layout/layout.bench.test.ts",
    "test:bun": "bun test src/layout/determinism.test.ts",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "screenwriting",
    "screenplay",
    "yjs",
    "collaborative",
    "fadewright"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/fontkit": "~2.0.9",
    "@types/node": "~22.20.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "fast-check": "~4.10.1",
    "fast-xml-parser": "~5.11.1",
    "fontkit": "~2.0.4",
    "globals": "~16.5.0",
    "pdfjs-dist": "~6.3.289",
    "rimraf": "~6.1.3",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/writing_core.git"
  },
  "dependencies": {
    "@noble/hashes": "~2.4.0",
    "harfbuzzjs": "1.6.1",
    "yjs": "~13.6.32",
    "zod": "~4.6.5"
  }
}
